####################################################
# PC HUB 2.0 — Environment Configuration
# cp .env.example .env  and fill required values
####################################################

# ── Database ─────────────────────────────────────
DATABASE_URL=postgresql://pchub:CHANGE_PASSWORD@localhost:5432/pchub?schema=public
POSTGRES_DB=pchub
POSTGRES_USER=pchub
POSTGRES_PASSWORD=CHANGE_THIS_MIN_32_CHARS
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Security (REQUIRED) ───────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_EXPIRES_IN=8h

# ── App ───────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── CORS ─────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200

# ── Rate Limiting ─────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=200

# ── Docker ports ─────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443

# syntax=docker/dockerfile:1.4
# Build context = project root (set in docker-compose.yml)
FROM node:20-alpine AS builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
ARG API_URL=/api
ENV API_URL=$API_URL
RUN npm run build

FROM nginx:1.25-alpine AS production
COPY --from=builder /app/dist/pchub-frontend/browser /usr/share/nginx/html
COPY infrastructure/docker/nginx-docker.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s CMD wget -q -O- http://localhost/health || exit 1
CMD ["nginx", "-g", "daemon off;"]
